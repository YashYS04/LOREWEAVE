# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=loreweave
APP_ENV=development
APP_VERSION=0.1.0

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (development default)
DATABASE_URL=sqlite+aiosqlite:///./loreweave.db

# PostgreSQL (production — uncomment and fill)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/loreweave

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=LOREWEAVE

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI / Ollama ────────────────────────────────────────────────────────────────
# Local Ollama instance running IBM Granite 3.3 2B
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:2b
OLLAMA_TIMEOUT=120

AI_TEMPERATURE=0.4
AI_MAX_TOKENS=2048

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
